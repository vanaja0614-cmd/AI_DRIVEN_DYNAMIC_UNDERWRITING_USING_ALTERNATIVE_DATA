# Copy to `.env` and adjust. Never commit the real `.env`.

APP_NAME=TrustFlow AI
APP_VERSION=1.0.0
DEBUG=true

# Postgres (production) or SQLite (local dev, e.g. sqlite:///./trustflow.db)
DATABASE_URL=postgresql://trustflow:trustflow_password@localhost:5432/trustflow

# Auth
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model artifacts
RISK_MODEL_PATH=ml/models/risk_model.pkl
FRAUD_MODEL_PATH=ml/models/fraud_model.pkl

# Firebase Realtime Database (REST fallback; no credentials required for
# public-rules databases). Optional service account JSON for admin SDK.
FIREBASE_DB_URL=https://trustflow-5f98e-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_PATH=
